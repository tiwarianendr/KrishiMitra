# ==============================================================
# KrishiMitra Platform Environment Configuration
# Copy this file to .env and adjust variables as required
# ==============================================================

# Application Security
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-separate-super-secure-jwt-key
JWT_EXPIRE_DAYS=7

# Database Configuration
# PostgreSQL for production: postgresql://postgres:password@localhost:5432/krishimitra
# Default SQLite fallback for zero-configuration local development:
DATABASE_URL=sqlite:///krishimitra.db

# Server Ports & CORS (comma-separated frontend URLs allowed to call backend)
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://krishi-mitra-woad.vercel.app

# File Upload Settings
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=16777216

# AI / Machine Learning Model Paths
MODEL_PATH=backend/model/crop_disease_model.keras
DISEASES_DATA_PATH=backend/data/diseases.json
CLASS_INDICES_PATH=backend/data/class_indices.json

# External API Integrations (Optional)
# Open-Meteo works out-of-the-box with NO API key needed!
# Provide OPENWEATHER_API_KEY only if you specifically wish to use OpenWeatherMap
OPENWEATHER_API_KEY=

# Conversational LLM API Keys (Optional)
# If provided, the AI Assistant will call Google Gemini or Groq Llama 3
# If left blank, the assistant runs on the built-in agronomy knowledge & rule engine!
GEMINI_API_KEY=
GROQ_API_KEY=
